{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://probe.ai/schemas/probe-suite-v1alpha1.json",
  "title": "ProbeSuite",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "probe.ai/v1alpha1" },
    "kind": { "const": "ProbeSuite" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layer", "protocol", "request", "sampling", "assertions"],
      "properties": {
        "layer": { "enum": ["L0", "L1", "L2", "L3", "L4", "L5", "L6"] },
        "protocol": { "const": "openai-chat" },
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["prompt", "stream", "max_output_tokens"],
          "properties": {
            "prompt": { "type": "string", "minLength": 1 },
            "stream": { "type": "boolean" },
            "max_output_tokens": { "type": "integer", "minimum": 1, "maximum": 4096 }
          }
        },
        "sampling": {
          "type": "object",
          "additionalProperties": false,
          "required": ["warmup", "requests", "concurrency", "timeout_seconds", "max_cost_usd"],
          "properties": {
            "warmup": { "type": "integer", "minimum": 0, "maximum": 20 },
            "requests": { "type": "integer", "minimum": 1, "maximum": 10000 },
            "concurrency": { "type": "integer", "minimum": 1, "maximum": 1000 },
            "timeout_seconds": { "type": "number", "exclusiveMinimum": 0 },
            "max_cost_usd": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/assertion" }
        }
      }
    }
  },
  "$defs": {
    "assertion": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "equals"],
          "properties": {
            "type": { "const": "http_status" },
            "equals": { "type": "integer", "minimum": 100, "maximum": 599 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "gte"],
          "properties": {
            "type": { "const": "success_rate" },
            "gte": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "equals"],
          "properties": {
            "type": { "const": "exact_text" },
            "equals": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": {
              "enum": [
                "output_nonempty", "sse_sequence_valid", "finish_reason_present",
                "pseudo_stream_absent"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "p95_lte"],
          "properties": {
            "type": { "enum": ["ttft_ms", "e2e_ms"] },
            "p95_lte": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      ]
    }
  }
}
