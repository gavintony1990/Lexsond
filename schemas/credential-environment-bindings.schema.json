{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://probe.ai/schemas/credential-environment-bindings.schema.json",
  "title": "Credential Environment Binding List",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "items"],
  "properties": {
    "apiVersion": {
      "const": "probe.ai/credential-bindings/v1alpha1"
    },
    "kind": {
      "const": "CredentialEnvironmentBindingList"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["credential_ref", "environment_variable"],
        "properties": {
          "credential_ref": {
            "type": "string",
            "pattern": "^(vault|aws-secretsmanager|gcp-secretmanager|azure-keyvault)://[^/?#@]+(/[^?#]*)?$",
            "maxLength": 2048
          },
          "environment_variable": {
            "type": "string",
            "pattern": "^LEXSOND_SECRET_[A-Z0-9_]{1,96}$"
          }
        }
      }
    }
  }
}
