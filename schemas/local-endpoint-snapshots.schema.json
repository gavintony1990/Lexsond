{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://probe.ai/schemas/local-endpoint-snapshots-v1alpha1.json",
  "title": "Local Endpoint Snapshot List",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "items"],
  "properties": {
    "apiVersion": { "const": "probe.ai/endpoints/v1alpha1" },
    "kind": { "const": "EndpointSnapshotList" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "endpoint_snapshot_id",
          "protocol",
          "base_url",
          "model",
          "credential_handle"
        ],
        "properties": {
          "endpoint_snapshot_id": { "type": "string", "minLength": 1 },
          "protocol": { "const": "openai-chat" },
          "base_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://[^?#]+$"
          },
          "model": { "type": "string", "minLength": 1 },
          "credential_handle": {
            "type": "string",
            "pattern": "^env://LEXSOND_SECRET_[A-Z0-9_]{1,96}$"
          }
        }
      }
    }
  }
}
